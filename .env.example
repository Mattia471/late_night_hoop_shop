# Copia questo file in .env.local
# Project Settings -> API -> Project URL
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Usa la publishable key del progetto. Anche la legacy anon key funziona con supabase-js v2.
# NON inserire mai la secret/service_role key nel frontend.
REACT_APP_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
